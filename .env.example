# .env.example — commité sur le repo public
# Copier en .env.local et remplir les valeurs réelles

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=""                    # Neon PostgreSQL connection string

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""                 # openssl rand -base64 32
NEXTAUTH_URL=""                    # http://localhost:3000 en dev, https://overture.app en prod

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── APIs Concerts ────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=""
BANDSINTOWN_APP_ID=""

# ─── Cache ────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ─── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=""        # Public, exposé côté client — restreindre le domaine dans le dashboard Mapbox

# ─── Crons ────────────────────────────────────────────────────────────────────
CRON_SECRET=""                     # openssl rand -base64 32 — protège /api/concerts/sync et /api/alerts/notify

# ─── Steam (V2) ───────────────────────────────────────────────────────────────
STEAM_API_KEY=""
